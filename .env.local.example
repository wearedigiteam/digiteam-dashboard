# ── Digiteam Dashboard — Environment Variables ───────────────────────────────
# Copy this to .env.local for local development.
# In Vercel: add these under Project Settings → Environment Variables.
# NEVER commit .env.local to git.

# Dashboard password — the single password used to access the dashboard
DASHBOARD_PASSWORD=choose-a-strong-password-here

# Session secret — used to sign session cookies. Use a random 32+ char string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-char-string

# GitHub Personal Access Token — classic token with `repo` scope
# Create at: https://github.com/settings/tokens
GITHUB_PAT=ghp_your_token_here

# Userback API key
# Found in: Userback → Settings → API
USERBACK_API_KEY=your-userback-api-key-here
